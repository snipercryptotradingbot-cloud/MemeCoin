{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mememint-api",
  "main": "api-worker.js",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mememint-db",
      "database_id": "d9f9df79-99e0-4725-9727-27cf13a9042b"
    }
  ]
}

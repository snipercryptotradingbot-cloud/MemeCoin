{
  "name": "mememint",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "stage-deploy": "node scripts/stage-deploy.js || echo manual-staging",
    "stage-deploy:full": "npm run build || echo build-blocked && node scripts/stage-deploy.js || echo manual-staging && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@meteora-ag/dlmm": "^1.9.14",
    "@reown/appkit": "^1.6.8",
    "@reown/appkit-adapter-solana": "^1.6.8",
    "@solana/spl-token": "^0.4.9",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "eventemitter3": "^5.0.4",
    "framer-motion": "^11.11.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.18",
    "pino-pretty": "^13.1.3",
    "wrangler": "^4.104.0"
  },
  "packageManager": "pnpm@11.25.0"
}